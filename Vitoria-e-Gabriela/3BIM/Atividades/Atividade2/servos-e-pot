#include <Servo.h>

// Criando os 4 servos
Servo serv1;
Servo serv2;
Servo serv3;
Servo serv4;

// Entradas dos potenciômetros
int pot1 = A3;
int pot2 = A2;
int pot3 = A1;
int pot4 = A0;

// Variáveis para guardar os valores dos potenciômetros
int valor1;
int valor2;
int valor3;
int valor4;

// Variáveis para guardar os movimentos dos servos
int mov1;
int mov2;
int mov3;
int mov4;

void setup() {

  // Definindo os pinos dos servos
  serv1.attach(2);
  serv2.attach(3);
  serv3.attach(4);
  serv4.attach(5);
}

void loop() {

  // Lendo os potenciômetros
  valor1 = analogRead(pot1);
  valor2 = analogRead(pot2);
  valor3 = analogRead(pot3);
  valor4 = analogRead(pot4);

  // Transformando 0-1023 em 0-180 graus
  mov1 = map(valor1, 0, 1023, 0, 180);
  mov2 = map(valor2, 0, 1023, 0, 180);
  mov3 = map(valor3, 0, 1023, 0, 180);
  mov4 = map(valor4, 0, 1023, 0, 180);

  // Mandando os movimentos para os servos
  serv1.write(mov1);
  serv2.write(mov2);
  serv3.write(mov3);
  serv4.write(mov4);

  delay(15);
}
